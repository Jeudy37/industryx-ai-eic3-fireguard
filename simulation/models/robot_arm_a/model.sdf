<?xml version="1.0"?>
<sdf version="1.9">
<model name="robot_a">
<link name="base_link"><pose>0 0 0 0 0 0</pose><gravity>false</gravity><inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial><visual name="plate"><pose>0 0 0.015 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.03</length></cylinder></geometry><material><ambient>0.2 0.2 0.25 1.0</ambient><diffuse>0.2 0.2 0.25 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual></link>
<link name="turret"><pose>0 0 0 0 0 0</pose><gravity>false</gravity><inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial><visual name="column"><pose>0 0 0.075 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry><material><ambient>0.95 0.5 0.1 1.0</ambient><diffuse>0.95 0.5 0.1 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual><visual name="shoulder_ball"><pose>0 0 0.15 0 0 0</pose><geometry><sphere><radius>0.055</radius></sphere></geometry><material><ambient>0.2 0.2 0.25 1.0</ambient><diffuse>0.2 0.2 0.25 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual></link>
<link name="upper_arm"><pose>0 0 0.15 0 0 0</pose><gravity>false</gravity><inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial><visual name="v"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.06 0.06 0.3</size></box></geometry><material><ambient>0.95 0.5 0.1 1.0</ambient><diffuse>0.95 0.5 0.1 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual><visual name="elbow_ball"><pose>0 0 0.3 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.2 0.2 0.25 1.0</ambient><diffuse>0.2 0.2 0.25 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual></link>
<link name="forearm"><pose>0 0 0.44999999999999996 0 0 0</pose><gravity>false</gravity><inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial><visual name="v"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.05 0.05 0.3</size></box></geometry><material><ambient>0.95 0.5 0.1 1.0</ambient><diffuse>0.95 0.5 0.1 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual><visual name="wrist_ball"><pose>0 0 0.3 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.2 0.2 0.25 1.0</ambient><diffuse>0.2 0.2 0.25 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual></link>
<link name="gripper"><pose>0 0 0.75 0 0 0</pose><gravity>false</gravity><inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial><visual name="v"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.1</size></box></geometry><material><ambient>0.95 0.85 0.1 1.0</ambient><diffuse>0.95 0.85 0.1 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual><visual name="pad"><pose>0 0 0.094 0 0 0</pose><geometry><box><size>0.07 0.015 0.012</size></box></geometry><material><ambient>0.2 0.2 0.25 1.0</ambient><diffuse>0.2 0.2 0.25 1.0</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual></link>
<joint name="world_fix" type="fixed"><parent>world</parent><child>base_link</child></joint>
<joint name="joint1" type="revolute"><parent>base_link</parent><child>turret</child><axis><xyz>0 0 1</xyz><limit><lower>-3.1416</lower><upper>3.1416</upper><effort>50</effort><velocity>3</velocity></limit><dynamics><damping>0.5</damping></dynamics></axis></joint>
<joint name="joint2" type="revolute"><parent>turret</parent><child>upper_arm</child><axis><xyz>0 1 0</xyz><limit><lower>-0.4</lower><upper>2.2</upper><effort>50</effort><velocity>3</velocity></limit><dynamics><damping>0.5</damping></dynamics></axis></joint>
<joint name="joint3" type="revolute"><parent>upper_arm</parent><child>forearm</child><axis><xyz>0 1 0</xyz><limit><lower>-0.2</lower><upper>2.8</upper><effort>50</effort><velocity>3</velocity></limit><dynamics><damping>0.5</damping></dynamics></axis></joint>
<joint name="joint4" type="revolute"><parent>forearm</parent><child>gripper</child><axis><xyz>0 1 0</xyz><limit><lower>-0.6</lower><upper>3.3</upper><effort>50</effort><velocity>3</velocity></limit><dynamics><damping>0.5</damping></dynamics></axis></joint>
<plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint1</joint_name><topic>/robot_a/j1/cmd</topic><p_gain>80</p_gain><i_gain>0</i_gain><d_gain>8</d_gain><cmd_max>50</cmd_max><cmd_min>-50</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint2</joint_name><topic>/robot_a/j2/cmd</topic><p_gain>80</p_gain><i_gain>0</i_gain><d_gain>8</d_gain><cmd_max>50</cmd_max><cmd_min>-50</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint3</joint_name><topic>/robot_a/j3/cmd</topic><p_gain>80</p_gain><i_gain>0</i_gain><d_gain>8</d_gain><cmd_max>50</cmd_max><cmd_min>-50</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint4</joint_name><topic>/robot_a/j4/cmd</topic><p_gain>80</p_gain><i_gain>0</i_gain><d_gain>8</d_gain><cmd_max>50</cmd_max><cmd_min>-50</cmd_min></plugin><plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
</model>
</sdf>
